@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    bool isAdmin = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Password Manager</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/password-manager.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Go to Home">
                <span class="brand-badge" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </span>
                <span class="brand-text">
                    <strong>Password Manager</strong>
                    <small>@(isAdmin ? "Admin Panel" : "Vault Overview")</small>
                </span>
            </a>

            <nav class="nav-actions" aria-label="Primary navigation">
                <a class="tab-btn @(isAdmin ? "" : "active")" asp-controller="Home" asp-action="Index">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Home</span>
                </a>

                <a class="tab-btn @(isAdmin ? "active" : "")" asp-controller="Admin" asp-action="Index">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    <span>Admin</span>
                </a>

                <button type="button" id="themeToggleBtn" class="tab-btn theme-toggle" aria-label="Toggle color theme">
                    <span id="themeLabel">Light Mode</span>
                </button>

                <button type="button" id="exportPdfBtn" class="btn-pdf">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Export PDF</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="main-container">
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert-banner alert-success" role="status">@successMsg</div>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <div class="alert-banner alert-error" role="alert">@errorMsg</div>
        }

        @RenderBody()
    </main>

    <dialog id="pdfThemeDialog" class="vault-dialog">
        <div class="dialog-content">
            <div class="dialog-header">
                <h2>Choose PDF Theme</h2>
                <button type="button" class="dialog-close-btn" data-close-dialog="pdfThemeDialog" aria-label="Close">&times;</button>
            </div>
            <p class="dialog-subtitle">Download your complete accounts table and recovery code blocks as a clean A4 PDF.</p>
            <div class="pdf-theme-options">
                <a class="pdf-theme-card light-option" asp-controller="Home" asp-action="ExportPdf" asp-route-theme="light">
                    <strong>Light PDF</strong>
                    <small>Clean white paper look, ideal for printing</small>
                </a>
                <a class="pdf-theme-card dark-option" asp-controller="Home" asp-action="ExportPdf" asp-route-theme="dark">
                    <strong>Dark PDF</strong>
                    <small>Deep slate &amp; indigo look for screen reading</small>
                </a>
            </div>
        </div>
    </dialog>

    <div id="toastMsg" class="toast-msg" role="status" aria-live="polite"></div>

    <script src="~/js/password-manager.js" asp-append-version="true"></script>
</body>
</html>
